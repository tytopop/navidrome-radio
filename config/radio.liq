# Navidrome Radio — Liquidsoap configuration
# Replace <ICECAST_SOURCE_PASS> before use, or run install.sh.

# ── Runtime settings ────────────────────────────────────────────────────────
settings.init.allow_root := true
settings.log.stdout      := true
settings.log.level       := 2

# ── Metadata formatter: "Artist - Title" ─────────────────────────────────────
def format_metadata(m) =
  artist = m["artist"] or ""
  title  = m["title"]  or ""
  if   artist != "" and title != "" then "#{artist} - #{title}"
  elsif artist != ""                then artist
  elsif title  != ""                then title
  else                                   "Unknown"
  end
end

# ── Source ────────────────────────────────────────────────────────────────────
# playlist() streams tracks from the M3U file generated by gen_playlist.py.
# mode="randomize" shuffles the list; reload=3600 picks up a new playlist hourly.
src = playlist(
  mode        = "randomize",
  reload      = 3600,
  reload_mode = "rounds",
  "/etc/radio/radio.m3u"
)

# mksafe() prevents liquidsoap from crashing if the playlist is temporarily empty.
src = mksafe(src)
src = metadata.map(f=format_metadata, src)

# ── Output → Icecast2 ─────────────────────────────────────────────────────────
output.icecast(
  %mp3(bitrate=192, samplerate=44100, stereo=true),
  host        = "127.0.0.1",
  port        = 8000,
  password    = "<ICECAST_SOURCE_PASS>",   # must match <source-password> in icecast.xml
  mount       = "radio",
  name        = "Home Navidrome Radio",
  description = "Endless random music from your Navidrome library",
  genre       = "Random",
  src
)
