<!-- Navidrome Radio — Icecast2 configuration template
     Replace every <PLACEHOLDER> with your own values before use,
     or run install.sh which does it automatically.
-->
<icecast>
    <location>Home Server</location>
    <admin>admin@localhost</admin>

    <limits>
        <clients>20</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <!-- Password used by Liquidsoap to push the stream -->
        <source-password><ICECAST_SOURCE_PASS></source-password>
        <!-- Icecast web admin credentials -->
        <admin-user>admin</admin-user>
        <admin-password><ICECAST_ADMIN_PASS></admin-password>
        <relay-password>relay_change_me</relay-password>
    </authentication>

    <!-- IP or hostname of this container / machine -->
    <hostname><RADIO_IP></hostname>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <!-- Allow web players on other origins to connect -->
    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
    </http-headers>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <!-- 1=error 2=warn 3=info 4=debug -->
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>
</icecast>
